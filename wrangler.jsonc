{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nutricontrol",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-19",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}